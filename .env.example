# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# HMAC key for signed cookies and for salting rate-limit keys.
# Generate with: openssl rand -base64 32
APP_SECRET=

# Address that verification codes are sent from.
EMAIL_FROM="Exposure Scanner <noreply@example.com>"

# Email delivery. Set RESEND_API_KEY or SMTP_URL.
# If neither is set, codes are written to the server log in development only
# and verification is refused in production.
RESEND_API_KEY=
SMTP_URL=

# ---------------------------------------------------------------------------
# Optional: rate limiting
#
# Without these, rate limits are enforced in-process. That is fine for local
# development but does not hold across serverless instances -- set them in
# production.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: bot protection on the verification step.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Optional: data sources
#
# Every one of these is optional. A source with no key reports itself as
# "not configured" in the scan report rather than being silently skipped.
# ---------------------------------------------------------------------------

# Have I Been Pwned. A Pro subscription enables k-anonymity search, which means
# the full address never leaves this server, plus stealer-log lookups.
# IMPORTANT: review the HIBP Terms of Use before enabling this in production.
# See docs/legal.md.
HIBP_API_KEY=

# Gravatar. Unauthenticated requests work but return fewer profile fields.
GRAVATAR_API_KEY=

# GitHub. Raises the unauthenticated limit of 60 req/hr to 5,000 req/hr.
GITHUB_TOKEN=

# Web search. Brave and Mojeek run their own indexes.
BRAVE_SEARCH_API_KEY=
MOJEEK_API_KEY=

# Google-scraping SERP providers carry legal risk (Google v. SerpAPI, Dec 2025)
# and are disabled unless this is explicitly set to "true".
ENABLE_SERP_SCRAPER_PROVIDERS=false

# ---------------------------------------------------------------------------
# Optional: scan tuning
# ---------------------------------------------------------------------------

# Wall-clock budget for a scan. When it expires the scan reports honest partial
# completion ("checked 540 of 712 sites") rather than truncating silently.
# Keep below your platform's function timeout (Vercel Pro caps at 300s).
SCAN_BUDGET_MS=240000

# Concurrent outbound requests during the username sweep.
SCAN_USERNAME_CONCURRENCY=24
