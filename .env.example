# ---------------------------------------------------------------------------
# Nothing here is required.
#
# `npm install && npm run dev` works with no .env file at all: no email service,
# no database, no API keys, no cost. Everything below is optional.
# ---------------------------------------------------------------------------

# Recommended for a real deployment. Salts rate-limit keys and signs cookies.
# Left unset, a temporary one is generated per process — fine locally, but it
# means rate-limit counters are not shared between instances.
# Generate with: openssl rand -base64 32
APP_SECRET=

# ---------------------------------------------------------------------------
# Optional: email verification
#
# Off by default. When off, nothing is emailed and ownership of an address is
# asserted rather than proved, which has two visible consequences: results from
# sensitive categories (adult, dating, political, health) are withheld from
# everyone, and the report carries a standing caveat.
#
# Turn this on — with a transport configured below — before enabling HIBP,
# whose terms restrict third-party use. See docs/legal.md.
# ---------------------------------------------------------------------------
REQUIRE_EMAIL_VERIFICATION=false

# Only needed when REQUIRE_EMAIL_VERIFICATION is true.
EMAIL_FROM="Exposure Scanner <noreply@example.com>"
RESEND_API_KEY=
SMTP_URL=

# ---------------------------------------------------------------------------
# Optional: rate limiting
#
# Without these, rate limits are enforced in-process. That is fine for local
# development but does not hold across serverless instances -- set them in
# production.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: bot protection on the verification step (only used when
# REQUIRE_EMAIL_VERIFICATION is true).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Optional: data sources
#
# Every one of these is optional. A source with no key reports itself as
# "not configured" in the scan report rather than being silently skipped.
# ---------------------------------------------------------------------------

# Have I Been Pwned. A Pro subscription enables k-anonymity search, which means
# the full address never leaves this server, plus stealer-log lookups.
# IMPORTANT: review the HIBP Terms of Use before enabling this in production.
# See docs/legal.md.
HIBP_API_KEY=

# Gravatar. Unauthenticated requests work but return fewer profile fields.
GRAVATAR_API_KEY=

# GitLab, Docker Hub, npm, Bitbucket and the DNS lookup of your email domain
# need no configuration at all. They are always on.

# GitHub. Raises the unauthenticated limit of 60 req/hr to 5,000 req/hr.
GITHUB_TOKEN=

# Web search runs on SearXNG and needs no key. Point this at your own instance
# for reliable results; left unset, a few public instances are tried.
SEARXNG_URL=

# Optional commercial search, if you would rather pay than self-host.
BRAVE_SEARCH_API_KEY=
MOJEEK_API_KEY=

# Google-scraping SERP providers carry legal risk (Google v. SerpAPI, Dec 2025)
# and are disabled unless this is explicitly set to "true".
ENABLE_SERP_SCRAPER_PROVIDERS=false

# ---------------------------------------------------------------------------
# Optional: scan tuning
# ---------------------------------------------------------------------------

# Wall-clock budget for a scan. When it expires the scan reports honest partial
# completion ("checked 540 of 703 sites") rather than truncating silently.
# Keep below your platform's function timeout (Vercel Pro caps at 300s).
SCAN_BUDGET_MS=120000

# Concurrent outbound requests during the username sweep. Raise it if scans feel
# slow and your network can take it.
SCAN_USERNAME_CONCURRENCY=32

# How many scans one address, and one IP, may run per day. The defaults are
# sized for a public deployment; raise them freely if you are the only user.
SCAN_LIMIT_PER_EMAIL_PER_DAY=20
SCAN_LIMIT_PER_IP_PER_DAY=100
